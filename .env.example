PORT=4310
# Default: loopback only. Keep this for local use.
HOST=127.0.0.1
# PROJECT_ROOT=/absolute/path/to/projects
# Optional additional project folders (JSON array); duplicate names prefer PROJECT_ROOT.
# PROJECT_ROOTS='["/another/disk/projects"]'
# Vercel CLI auth is detected automatically on macOS, without copying its token.
# VERCEL_CLI_AUTH_PATH=/absolute/path/to/official-cli/auth.json
# For remote access, use an HTTPS reverse proxy or private SSH tunnel.
# HOST=0.0.0.0
# DASHBOARD_PASSWORD=at-least-16-characters
# PUBLIC_ORIGIN=https://your-private-domain.example
# COOKIE_SECURE=true
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json

# Optional read-only deployment lookup
# VERCEL_TOKEN=your-server-side-token
# GITHUB_TOKEN=your-repository-metadata-read-token
# SUPABASE_ACCESS_TOKEN=your-projects-and-organizations-read-token
# CLOUDFLARE_API_TOKEN=your-account-settings-read-token
# CODEX_BIN=/opt/homebrew/bin/codex
# CLAUDE_BIN=/opt/homebrew/bin/claude
# Claude quota receiver: npm run connect:claude (then claude auth login if needed)
# Optional shared path for the status line collector and server DATA_DIR:
# MANAGE_A_DATA_DIR=/absolute/path/to/Manage-A/.local
# DISABLE_BACKGROUND_SYNC=1
